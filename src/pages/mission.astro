---
import LegacyPageContent from '../components/LegacyPageContent.astro';
import { getStaticWixPage } from '../data/wix-static';

const page = getStaticWixPage('/mission');
if (!page) throw new Error('Wix mission snapshot is missing.');
---

<LegacyPageContent page={page} title="예봄사역" intro="교육부서와 선교활동을 소개합니다." />
