---
import LegacyPageContent from '../components/LegacyPageContent.astro';
import { getStaticWixPage } from '../data/wix-static';

const page = getStaticWixPage('/people');
if (!page) throw new Error('Wix people snapshot is missing.');
---

<LegacyPageContent page={page} title="예봄피플" intro="예봄교회를 섬기는 이들을 소개합니다." />
