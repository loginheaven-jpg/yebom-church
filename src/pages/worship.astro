---
import LegacyPageContent from '../components/LegacyPageContent.astro';
import { getStaticWixPage } from '../data/wix-static';

const page = getStaticWixPage('/worship');
if (!page) throw new Error('Wix worship snapshot is missing.');
---

<LegacyPageContent page={page} title="예배안내" intro="예봄교회 예배와 모임을 안내합니다." />
