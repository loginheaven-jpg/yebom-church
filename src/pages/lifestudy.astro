---
import Layout from '../layouts/Layout.astro';
import { lifeStudyPages } from '../data/wix-static';
---

<Layout title="삶공부" description="예봄교회 삶공부 과정과 진도표를 안내합니다.">
  <article class="legacy-page life-study-index">
    <header class="legacy-page__lead">
      <span class="legacy-page__eyebrow">YEBOM LIFE STUDY</span>
      <h1>삶공부</h1>
      <p>예봄교회 삶공부의 각 과정과 진도표를 확인할 수 있습니다.</p>
      <div aria-hidden="true"></div>
    </header>
    <nav class="life-study-index__grid" aria-label="삶공부 과정">
      {lifeStudyPages.map((page) => (
        <a href={page.path}>
          <span>{page.path.replace('/lifestudy', '').padStart(2, '0')}</span>
          <strong>{page.headline}</strong>
          <i>과정 및 진도표 보기</i>
        </a>
      ))}
    </nav>
  </article>
</Layout>
