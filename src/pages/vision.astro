---
import LegacyPageContent from '../components/LegacyPageContent.astro';
import { getStaticWixPage } from '../data/wix-static';

const page = getStaticWixPage('/vision');
if (!page) throw new Error('Wix vision snapshot is missing.');
---

<LegacyPageContent page={page} title="예봄비전" intro="가정교회를 통한 신약교회의 회복, 예봄이 꿈꾸는 비전입니다." />
