---
import LegacyPageContent from '../components/LegacyPageContent.astro';
import { getStaticWixPage } from '../data/wix-static';

const page = getStaticWixPage('/housechurch');
if (!page) throw new Error('Wix housechurch snapshot is missing.');
---

<LegacyPageContent page={page} title="가정교회" intro="신약교회의 회복을 지향하는 예봄의 가정교회를 소개합니다." />
