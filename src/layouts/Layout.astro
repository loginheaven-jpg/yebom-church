---
import '../styles/global.css';
import FloatingYebomMark from '../components/FloatingYebomMark.astro';
import VerticalNavigation from '../components/VerticalNavigation.astro';
import { canonicalUrl, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const { title, description = site.description, image = '/media/images/about-forest.jpg', noIndex: noIndexProp = false } = Astro.props;
const pagesBranch = process.env.CF_PAGES_BRANCH;
const pagesProductionBranch = process.env.CF_PAGES_PRODUCTION_BRANCH ?? 'master';
const noIndex = noIndexProp || Boolean(pagesBranch && pagesBranch !== pagesProductionBranch);
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.subtitle}`;
const canonical = canonicalUrl(Astro.url.pathname);
const socialImage = new URL(image, site.publicOrigin).toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-identity" href="/" aria-label="예봄교회 홈으로">
          <span class="site-identity__wordmark">YEBOM CHURCH</span>
          <span class="site-identity__subtitle">Presbyterian Church</span>
        </a>
        <VerticalNavigation />
      </header>
      <main class="site-main">
        <slot />
      </main>
      <FloatingYebomMark />
    </div>
  </body>
</html>
